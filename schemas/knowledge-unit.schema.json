{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookXray Knowledge Unit",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "section_id", "title", "explanation", "source_type", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "pattern": "^S[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "explanation": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "enum": ["book", "inference", "external"]},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "string"}},
    "limits_and_counterexamples": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "quote"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "quote": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
